// SplitEase (Hisab) database schema.
//
// The schema is derived from the application domain documented in the frontend
// models and manual:
//   - Groups + membership
//   - Expenses with per-participant splits
//   - Settlements between users
//   - Activity feed
//   - User/auth foundation
//
// Money is stored as INTEGER MINOR UNITS (PostgreSQL BIGINT) matching the
// frontend's `Money.minorUnits` (Dart `int` paisa) convention. No floating
// point is used anywhere for financial values.
//
// All identifiers use UUID strings generated by Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitType {
  EQUAL
  EXACT
}

enum ActivityType {
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_ADDED
  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_ADDED
  MEMBER_REMOVED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String?
  emailVerifiedAt DateTime?

  createdGroups   Group[]         @relation("GroupOwner")
  memberships     GroupMember[]
  paidExpenses    Expense[]       @relation("ExpensePayer")
  expenseSplits   ExpenseSplit[]
  settlementsPaid   Settlement[]         @relation("SettlementPayer")
  settlementsGot    Settlement[]         @relation("SettlementPayee")
  activities        ActivityEvent[]
  refreshTokens     RefreshToken[]
  idempotencyKeys   IdempotencyRecord[]
  authTokens        AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id          String @id @default(uuid())
  name        String
  createdById String

  owner       User            @relation("GroupOwner", fields: [createdById], references: [id], onDelete: Restrict)
  members     GroupMember[]   @relation("GroupMembership")
  expenses    Expense[]
  settlements Settlement[]
  activities  ActivityEvent[]
  summary     GroupSummary?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  userId  String

  group Group @relation("GroupMembership", fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
}

model Expense {
  id               String    @id @default(uuid())
  groupId          String
  paidById         String
  description      String
  amountMinorUnits BigInt
  currencyCode     String    @default("PKR")
  splitType        SplitType
  expenseDate      DateTime

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  splits ExpenseSplit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([paidById])
  @@index([expenseDate])
}

model ExpenseSplit {
  id               String @id @default(uuid())
  expenseId        String
  userId           String
  amountMinorUnits BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id               String   @id @default(uuid())
  groupId          String
  payerId          String
  payeeId          String
  amountMinorUnits BigInt
  currencyCode     String   @default("PKR")
  settledAt        DateTime

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer User  @relation("SettlementPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee User  @relation("SettlementPayee", fields: [payeeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([payerId])
  @@index([payeeId])
}

model ActivityEvent {
  id               String       @id @default(uuid())
  groupId          String
  userId           String
  type             ActivityType
  message          String
  amountMinorUnits BigInt?
  currencyCode     String?
  occurredAt       DateTime

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([occurredAt])
}

model GroupSummary {
  id                   String   @id @default(uuid())
  groupId              String   @unique
  totalSpentMinorUnits BigInt
  expenseCount         Int
  settlementCount      Int
  memberCount          Int
  currencyCode         String   @default("PKR")
  computedAt           DateTime

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// Reusable single-use authentication tokens (email verification, password
// reset). The raw token is only ever returned to the client at issuance time;
// PostgreSQL stores only its SHA-256 digest in `tokenHash`. `purpose` keeps
// token types isolated from each other and `consumedAt` enforces single-use.
model AuthToken {
  id        String           @id @default(uuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, purpose])
  @@index([expiresAt])
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
}

model IdempotencyRecord {
  id          String            @id @default(uuid())
  key         String            @unique
  userId      String
  requestHash String
  status      IdempotencyStatus
  operation   String
  scope       String?
  resourceId  String?
  createdAt   DateTime          @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
