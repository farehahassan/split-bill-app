# Server
PORT=3000
NODE_ENV=development

# Database
# Replace username/password/host/port with your local PostgreSQL credentials.
# The real password must only live in your local .env file, never commit it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitease

# Authentication (JWT)
# Generate a strong random secret, e.g. with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production, the backend refuses to boot with a secret shorter than 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Refresh-token session lifetime in days (opaque tokens, SHA-256 hashed at rest)
REFRESH_TOKEN_TTL_DAYS=30

# CORS
# Comma-separated allowlist of client origins the API is allowed to be called
# from. Unlisted origins are served without a CORS header (browsers block
# them). In production, loopback/localhost origins and the default below are
# rejected at boot so a misconfigured deployment fails loudly.
CORS_ORIGIN=http://localhost:3000

# Rate limiting
# Requests are tracked per client IP within a fixed window (in milliseconds).
# AUTH_RATE_LIMIT_MAX applies to /api/v1/auth/* only; RATE_LIMIT_MAX covers all other endpoints.
# AUTH_EMAIL_RATE_LIMIT_MAX applies to the public email-verification / password-
# recovery endpoints only and is kept far below the general auth budget.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
AUTH_EMAIL_RATE_LIMIT_MAX=5

# Public application origin used to build absolute links inside auth emails
# (e.g. https://app.hisab.example/verify-email?token=...). Must be an absolute URL.
APP_BASE_URL=http://localhost:3000

# Transactional email (email verification + password recovery)
# When EMAIL_ENABLED=false (default), auth emails are not sent to an SMTP server:
# the backend logs them instead, which is the local-development/testing behavior.
# Set EMAIL_ENABLED=true and the SMTP settings below for real delivery. The SMTP
# password must only live in your local .env file, never commit it.
EMAIL_ENABLED=false
EMAIL_HOST=localhost
EMAIL_PORT=587
# true = the port is an implicit TLS (SMTPS) port, false = STARTTLS on a plain port
EMAIL_SECURE=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
# From address and display name used on outgoing emails.
EMAIL_FROM=no-reply@localhost
EMAIL_FROM_NAME=Hisab

# Branding shown inside emails (also used as the application title).
APP_NAME=Hisab Split Bill

# Token lifetimes for the email-based flows, in minutes.
# Verification links: 1440 minutes = 24 hours. Reset links: 60 minutes = 1 hour.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Redis (optional at runtime)
# Redis powers cross-instance rate limiting and distributed locking. If it is
# unreachable the API still serves: rate limiting falls back to process-local
# memory and locks degrade to running uncoordinated (both are logged). Never
# commit a REDIS_URL that contains a password.
REDIS_URL=redis://localhost:6379

# Integration-test infrastructure (used by `npm run test:integration` only)
# The integration suite runs against ISOLATED services (docker-compose.yml)
# which intentionally use different ports than dev (5433 vs 5432, 6380 vs
# 6379) so tests never touch -- and never clear -- development data. Override
# these to point CI at its own ephemeral services.
# INTEGRATION_DATABASE_URL=postgresql://splitease:splitease_test@localhost:5433/splitease_integration
# INTEGRATION_REDIS_URL=redis://localhost:6380/15

# Reverse proxy trust level for req.ip resolution (false = no proxy, "true"/"1"
# = trust first hop, "2"+ = hops, or an Express trust-proxy value such as
# "loopback" or "10.0.0.0/8"). Set this only when the app sits behind one.
TRUST_PROXY=false

# Distributed lock TTL in milliseconds. Must comfortably exceed the longest
# protected operation (here: settlement creation).
DISTRIBUTED_LOCK_TTL_MS=10000

# Background job queue (Redis-powered, processed by the worker process)
# Redis is REQUIRED for the worker; the API server still serves without it.
# JOB_QUEUE_MAX_ATTEMPTS is how many times a job is retried before it is dropped.
JOB_QUEUE_MAX_ATTEMPTS=5
# Exponential backoff: base delay for the first retry, capped at the max.
JOB_QUEUE_BASE_BACKOFF_MS=2000
JOB_QUEUE_MAX_BACKOFF_MS=60000
# How long a worker "leases" a claimed job before another worker may retry it.
JOB_QUEUE_LEASE_MS=30000
# TTL of a queued job payload; must exceed the full retry horizon.
JOB_QUEUE_PAYLOAD_TTL_MS=86400000
# How often an idle worker polls the queue.
JOB_QUEUE_POLL_INTERVAL_MS=100

# Cache-aside Redis caching (performance layer only; PostgreSQL is authoritative)
# TTL for cached group details. Group name + membership are relatively stable and
# every mutating group operation invalidates the entry, so this is a safety net
# cap for missed invalidations and a memory bound, not the freshness guarantee.
CACHE_GROUP_TTL_SECONDS=300

# Observability / metrics
# When true, the API exposes aggregate metrics at GET /metrics (Prometheus text
# format). The payload contains no user data, IDs, or secrets - only bounded
# counters/histograms - but production deployments may prefer to disable it here
# or restrict the route at the gateway.
METRICS_ENABLED=true
# Optional scrape port for the background worker process, which has no HTTP
# server of its own (its job/Redis metrics live in the worker). Leave unset to
# disable; set to a dedicated port when running the worker.
# METRICS_PORT=9101
